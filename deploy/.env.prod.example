# ─────────────────────────────────────────────────────────────
# BOINDANG 프로덕션 환경변수 예시.
# 이 파일을 deploy/.env.prod 로 복사하고 실제 값을 채운 뒤,
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# 실제 비밀값을 절대 git 에 커밋하지 말 것. (.env.prod 는 .gitignore 에)
# ─────────────────────────────────────────────────────────────

# ── JWT (gateway/auth 공유. 두 서비스가 반드시 같은 값이어야 검증됨) ──
# 32자 이상 랜덤 문자열. 예) openssl rand -base64 48
JWT_SECRET=

# ── MySQL (단일 인스턴스, DB 6개) ──
MYSQL_ROOT_PASSWORD=          # root 비밀번호 (healthcheck/관리용)
MYSQL_USER=boindang           # 앱 공용 계정명 (init 스크립트의 'boindang' 과 일치시킬 것)
MYSQL_PASSWORD=               # 앱 공용 계정 비밀번호

# ── MongoDB (nutrition-service + ocr-service 공용, DB=nutrition_db) ──
MONGO_ROOT_USERNAME=          # mongo root (admin)
MONGO_ROOT_PASSWORD=
MONGO_APP_USERNAME=           # init-mongo.js 가 nutrition_db 에 만드는 앱 계정
MONGO_APP_PASSWORD=
# 앱이 접속할 최종 URI. 위 APP 계정/비번을 넣고 authSource=nutrition_db 유지.
# 예) mongodb://<APP_USERNAME>:<APP_PASSWORD>@mongo:27017/nutrition_db?authSource=nutrition_db
MONGO_APP_URI=

# ── CLOVA OCR (네이버 클라우드 OCR) ──
CLOVA_OCR_API_URL=            # 예) https://xxxxx.apigw.ntruss.com/custom/v1/.../general
CLOVA_OCR_SECRET_KEY=

# ── OpenAI (GPT-4.1-mini 분석) ──
OPENAI_API_URL=               # 예) https://api.openai.com/v1/chat/completions
OPENAI_API_KEY=

# ── AWS S3 (image-service presigned URL 발급) ──
# 기존 버킷/CloudFront 를 그대로 재사용한다면 그 버킷의 자격증명을 넣을 것.
S3_BUCKET_NAME=
S3_ACCESS_KEY=
S3_SECRET_ACCESS_KEY=
S3_REGION=                    # 예) ap-northeast-2

# ── 프론트엔드 (빌드타임 주입, NEXT_PUBLIC_* 는 번들에 박힘) ──
# same-origin 이라 /api 프리픽스로 게이트웨이에 붙는다. 도메인 바꾸면 여기도 수정 + 재빌드.
NEXT_PUBLIC_API_BASE_URL=https://boindang.duckdns.org/api
# 이미지 CDN(CloudFront) 베이스. 기존 배포와 같은 버킷/배포면 기존 도메인 유지.
NEXT_PUBLIC_CDN_BASE_URL=https://d1d5plumlg2gxc.cloudfront.net

# ── (참고) 아래는 compose 가 코드로 고정 주입하므로 .env 에 넣지 않아도 됨 ──
#   EUREKA_URL=http://eureka:8761/eureka/
#   REDIS_HOST=redis / ELASTICSEARCH_URL=elasticsearch / BOOTSTRAP_SERVER=kafka:9092
#   HOST_IP=<각 서비스명> / COOKIE_SECURE=true
#   boindang-user 의 DB_URL 은 jdbc:p6spy:mysql://... (p6spy 형식, compose 에 고정)
